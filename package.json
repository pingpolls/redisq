{
    "author": "PingPolls",
    "dependencies": {
        "croner": "~10.0.1"
    },
    "description": "RedisQ is simple message queue that utilizes Bun runtime for high performance read/writes.",
    "devDependencies": {
        "@biomejs/biome": "~2.4.16",
        "@types/bun": "~1.3.14",
        "typescript": "~5.9.3"
    },
    "exports": {
        ".": {
            "import": "./dist/app.js",
            "require": "./dist/app.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "redis",
        "queue",
        "message-queue",
        "rsmq",
        "bun"
    ],
    "license": "Apache License 2.0",
    "main": "./dist/app.js",
    "module": "./dist/app.js",
    "name": "@pingpolls/redisq",
    "peerDependencies": {
        "typescript": "~5"
    },
    "private": false,
    "scripts": {
        "build": "tsc",
        "check": "bun test --timeout 10000",
        "prepack": "bun run build",
        "release": "bun run build && bun test --timeout 10000 && bunx --bun npm publish --access public",
        "stress": "bun benchmark/stress.ts"
    },
    "type": "module",
    "types": "./dist/app.d.ts",
    "version": "1.0.7"
}
